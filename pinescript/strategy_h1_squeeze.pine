// This Pine Script™ source code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/

//@version=5
strategy("BTC 1D H1: Squeeze Breakout", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=5,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     max_bars_back=500,
     pyramiding=0)

// ============================================================
// CONFIGURATION
// ============================================================
group_squeeze = "Squeeze Detection"
i_bb_len         = input.int(20, "BB Length", group=group_squeeze)
i_bb_mult        = input.float(2.0, "BB Multiplier", group=group_squeeze)
i_kc_len         = input.int(20, "Keltner Length", group=group_squeeze)
i_kc_mult        = input.float(1.5, "Keltner Multiplier", minval=1.0, maxval=3.0, step=0.1, group=group_squeeze)
i_squeeze_bars   = input.int(6, "Min Squeeze Bars", minval=3, maxval=15, group=group_squeeze)
// OVERFIT RISK: squeeze_bars and kc_mult are sensitive — fewer bars = more signals but more false positives
i_linreg_len     = input.int(20, "LinReg Length", group=group_squeeze)
i_ema_fast       = input.int(21, "Fast EMA (direction)", group=group_squeeze)

group_risk = "Risk Management"
i_atr_len        = input.int(14, "ATR Length", group=group_risk)
i_squeeze_stop   = input.float(2.0, "Initial Stop ATR Mult", minval=1.0, maxval=4.0, step=0.1, group=group_risk)
i_squeeze_trail  = input.float(3.0, "Trail ATR Mult", minval=2.0, maxval=5.0, step=0.1, group=group_risk)
i_squeeze_max_bars = input.int(30, "Max Bars Held", minval=10, maxval=60, group=group_risk)
i_target_vol     = input.float(30.0, "Target Annual Vol %", group=group_risk)
i_short_size_mult = input.float(0.5, "Short Size Multiplier", group=group_risk)
i_warmup_bars    = input.int(400, "Warm-up Bars", group=group_risk)

// ============================================================
// INDICATORS
// ============================================================
ema_fast = ta.ema(close, i_ema_fast)
atr_val = ta.atr(i_atr_len)
atr_norm = atr_val / close * 100.0

[bb_mid, bb_upper, bb_lower] = ta.bb(close, i_bb_len, i_bb_mult)

kc_basis = ta.ema(close, i_kc_len)
kc_range = ta.atr(i_kc_len) * i_kc_mult
kc_upper = kc_basis + kc_range
kc_lower = kc_basis - kc_range

// Linear regression slope
linreg_val = ta.linreg(close, i_linreg_len, 0)
linreg_prev = ta.linreg(close, i_linreg_len, 1)
linreg_slope = linreg_val - linreg_prev

// ============================================================
// SQUEEZE DETECTION
// ============================================================
// BB inside KC = squeeze (volatility compressed below normal)
is_squeeze_bar = bb_lower > kc_lower and bb_upper < kc_upper
var int squeeze_count = 0
if is_squeeze_bar
    squeeze_count += 1
else
    squeeze_count := 0

squeeze_active = squeeze_count >= i_squeeze_bars
// Squeeze fires when BB expands back outside KC after being inside
squeeze_fired = not is_squeeze_bar and nz(squeeze_count[1]) >= i_squeeze_bars

// ============================================================
// POSITION SIZING
// ============================================================
daily_vol_target = i_target_vol / math.sqrt(365.0)
base_size_pct = atr_norm > 0 ? (daily_vol_target / atr_norm) * 100.0 : 10.0
clamped_size = math.max(5.0, math.min(100.0, base_size_pct))

// ============================================================
// STRATEGY LOGIC — H1 Squeeze Breakout
// ============================================================
can_trade = bar_index >= i_warmup_bars

var int entry_bar = 0
var float entry_price = 0.0
var float highest_since_entry = 0.0
var float lowest_since_entry = 0.0

in_long = strategy.position_size > 0
in_short = strategy.position_size < 0
in_position = in_long or in_short
bars_in_trade = bar_index - entry_bar

if in_position
    highest_since_entry := math.max(highest_since_entry, high)
    lowest_since_entry  := math.min(lowest_since_entry, low)
else
    highest_since_entry := high
    lowest_since_entry  := low

// --- Entries ---
long_signal  = squeeze_fired and linreg_slope > 0 and close > ema_fast
short_signal = squeeze_fired and linreg_slope < 0 and close < ema_fast

if long_signal and can_trade and not in_position
    strategy.entry("Long", strategy.long, qty=strategy.equity * clamped_size / 100.0 / close)
    entry_bar := bar_index
    entry_price := close
    highest_since_entry := high
    lowest_since_entry := low

if short_signal and can_trade and not in_position
    size = clamped_size * i_short_size_mult
    strategy.entry("Short", strategy.short, qty=strategy.equity * size / 100.0 / close)
    entry_bar := bar_index
    entry_price := close
    highest_since_entry := high
    lowest_since_entry := low

// --- Exits ---
if in_long
    init_stop = entry_price - i_squeeze_stop * atr_val
    trail_stop = highest_since_entry - i_squeeze_trail * atr_val
    effective_stop = math.max(init_stop, trail_stop)

    if low <= effective_stop
        strategy.close("Long", comment="H1 Stop")
    else if bars_in_trade >= i_squeeze_max_bars
        strategy.close("Long", comment="H1 Time Exit")

if in_short
    init_stop = entry_price + i_squeeze_stop * atr_val
    trail_stop = lowest_since_entry + i_squeeze_trail * atr_val
    effective_stop = math.min(init_stop, trail_stop)

    if high >= effective_stop
        strategy.close("Short", comment="H1 Stop")
    else if bars_in_trade >= i_squeeze_max_bars
        strategy.close("Short", comment="H1 Time Exit")

// ============================================================
// VISUALIZATION
// ============================================================
// Squeeze state: colored bar at bottom
plotshape(squeeze_active, "Squeeze Active", shape.diamond, location.belowbar, color.new(color.red, 30), size=size.tiny)
plotshape(squeeze_fired and linreg_slope > 0, "Fire Up", shape.triangleup, location.belowbar, color.lime, size=size.small)
plotshape(squeeze_fired and linreg_slope < 0, "Fire Down", shape.triangledown, location.abovebar, color.fuchsia, size=size.small)

// BB and KC bands
plot(bb_upper, "BB Upper", color=color.new(color.blue, 60))
plot(bb_lower, "BB Lower", color=color.new(color.blue, 60))
plot(kc_upper, "KC Upper", color=color.new(color.orange, 60))
plot(kc_lower, "KC Lower", color=color.new(color.orange, 60))
plot(ema_fast, "EMA 21", color=color.white, linewidth=1)
