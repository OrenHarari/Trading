// https://mozilla.org/MPL/2.0/

//@version=5
strategy("BTC 1D M1: BB + RSI Mean Reversion", overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.05,
     slippage=5,
     process_orders_on_close=false,
     calc_on_every_tick=false,
     max_bars_back=500,
     pyramiding=0)

// ============================================================
// CONFIGURATION
// ============================================================
group_regime = "Regime Detection"
i_ema_fast       = input.int(21, "Fast EMA", group=group_regime)
i_ema_slow       = input.int(55, "Slow EMA", group=group_regime)
i_adx_len        = input.int(14, "ADX Length", group=group_regime)
i_adx_threshold  = input.float(22.0, "ADX Threshold", group=group_regime)
i_adx_range_th   = input.float(18.0, "ADX Range Threshold", group=group_regime)
i_vats_lookback  = input.int(20, "VATS Lookback", group=group_regime)
i_vats_trend_th  = input.float(1.5, "VATS Trend Threshold", group=group_regime)
i_vats_range_th  = input.float(1.0, "VATS Range Threshold", group=group_regime)
i_regime_persist = input.int(3, "Regime Persistence Bars", group=group_regime)

group_entry = "Entry Parameters"
i_bb_len         = input.int(20, "BB Length", group=group_entry)
i_bb_mult        = input.float(2.0, "BB Multiplier", group=group_entry)
i_rsi_len        = input.int(14, "RSI Length", group=group_entry)
i_rsi_ob         = input.float(70.0, "RSI Overbought", group=group_entry)
i_rsi_os         = input.float(30.0, "RSI Oversold", group=group_entry)

group_vol = "Volatility"
i_atr_len        = input.int(14, "ATR Length", group=group_vol)
i_pctile_lookback = input.int(100, "Percentile Lookback", group=group_vol)
i_vol_high_th    = input.float(75.0, "Vol High Threshold", group=group_vol)

group_risk = "Risk Management"
i_mr_stop_mult   = input.float(1.5, "MR Stop ATR Mult", minval=0.5, maxval=3.0, step=0.1, group=group_risk)
i_mr_time_exit   = input.int(10, "MR Time Exit Bars", minval=3, maxval=20, group=group_risk)
i_target_vol     = input.float(30.0, "Target Annual Vol %", group=group_risk)
i_mr_size_mult   = input.float(0.7, "MR Size Multiplier", group=group_risk)
i_short_size_mult = input.float(0.5, "Short Size Multiplier", group=group_risk)
i_warmup_bars    = input.int(400, "Warm-up Bars", group=group_risk)

i_enable_regime  = input.bool(true, "Enable Regime Filter", group="Ablation")

// ============================================================
// INDICATORS
// ============================================================
ema_fast = ta.ema(close, i_ema_fast)
ema_slow = ta.ema(close, i_ema_slow)
[diplus, diminus, adx_val] = ta.dmi(i_adx_len, i_adx_len)
atr_val = ta.atr(i_atr_len)
atr_norm = atr_val / close * 100.0
rsi_val = ta.rsi(close, i_rsi_len)
[bb_mid, bb_upper, bb_lower] = ta.bb(close, i_bb_len, i_bb_mult)
bb_width = (bb_upper - bb_lower) / bb_mid

// VATS
price_displacement = math.abs(close - nz(close[i_vats_lookback]))
expected_displacement = math.max(atr_val * math.sqrt(i_vats_lookback), 0.0001)
vats = price_displacement / expected_displacement

// Percentile rank
percentile_rank(float src, int length) =>
    int count = 0
    for i = 1 to length
        if src[i] < src
            count += 1
    float(count) / float(length) * 100.0

atr_pctile = percentile_rank(atr_norm, i_pctile_lookback)
bbw_pctile = percentile_rank(bb_width, i_pctile_lookback)
vol_score  = (atr_pctile + bbw_pctile) / 2.0

// ============================================================
// REGIME (Classifier A)
// ============================================================
var int regime_a = 0
var int regime_a_counter = 0

raw_regime_a = 0
if vats > i_vats_trend_th and ema_fast > ema_slow and adx_val > i_adx_threshold
    raw_regime_a := 1
else if vats > i_vats_trend_th and ema_fast < ema_slow and adx_val > i_adx_threshold
    raw_regime_a := -1
else if vats < i_vats_range_th or adx_val < i_adx_range_th
    raw_regime_a := 0
else
    raw_regime_a := 2

if raw_regime_a == regime_a
    regime_a_counter := 0
else
    regime_a_counter += 1
    if regime_a_counter >= i_regime_persist
        regime_a := raw_regime_a
        regime_a_counter := 0

// ============================================================
// POSITION SIZING
// ============================================================
daily_vol_target = i_target_vol / math.sqrt(365.0)
base_size_pct = atr_norm > 0 ? (daily_vol_target / atr_norm) * 100.0 : 10.0
clamped_size = math.max(5.0, math.min(100.0, base_size_pct)) * i_mr_size_mult

// ============================================================
// STRATEGY LOGIC — M1 BB + RSI Mean Reversion
// ============================================================
can_trade = bar_index >= i_warmup_bars
eff_regime = i_enable_regime ? regime_a : 0

var int entry_bar = 0
var float entry_price = 0.0

in_long = strategy.position_size > 0
in_short = strategy.position_size < 0
in_position = in_long or in_short
bars_in_trade = bar_index - entry_bar

// --- Entries ---
long_signal  = close < bb_lower and rsi_val < i_rsi_os
short_signal = close > bb_upper and rsi_val > i_rsi_ob

long_ok  = can_trade and (eff_regime == 0 or not i_enable_regime) and vol_score < i_vol_high_th and not in_position
short_ok = can_trade and (eff_regime == 0 or not i_enable_regime) and vol_score < i_vol_high_th and not in_position

if long_signal and long_ok
    strategy.entry("Long", strategy.long, qty=strategy.equity * clamped_size / 100.0 / close)
    entry_bar := bar_index
    entry_price := close

if short_signal and short_ok
    size = clamped_size * i_short_size_mult
    strategy.entry("Short", strategy.short, qty=strategy.equity * size / 100.0 / close)
    entry_bar := bar_index
    entry_price := close

// --- Exits ---
if in_long
    if close >= bb_mid
        strategy.close("Long", comment="M1 Target")
    else if low <= entry_price - i_mr_stop_mult * atr_val
        strategy.close("Long", comment="M1 Stop")
    else if bars_in_trade >= i_mr_time_exit
        strategy.close("Long", comment="M1 Time Exit")
    else if i_enable_regime and (eff_regime == 1 or eff_regime == -1)
        strategy.close("Long", comment="M1 Regime Exit")

if in_short
    if close <= bb_mid
        strategy.close("Short", comment="M1 Target")
    else if high >= entry_price + i_mr_stop_mult * atr_val
        strategy.close("Short", comment="M1 Stop")
    else if bars_in_trade >= i_mr_time_exit
        strategy.close("Short", comment="M1 Time Exit")
    else if i_enable_regime and (eff_regime == 1 or eff_regime == -1)
        strategy.close("Short", comment="M1 Regime Exit")

// ============================================================
// VISUALIZATION
// ============================================================
regime_color = regime_a == 1 ? color.new(color.green, 90) : regime_a == -1 ? color.new(color.red, 90) : regime_a == 0 ? color.new(color.gray, 93) : color.new(color.yellow, 93)
bgcolor(regime_color, title="Regime")
plot(bb_upper, "BB Upper", color=color.purple)
plot(bb_mid,   "BB Mid",   color=color.new(color.purple, 50))
plot(bb_lower, "BB Lower", color=color.purple)
